# Payroll QA environment. Every value lives in the Vercel project (or .env.local for development). Never commit a filled copy.

# Postgres (Neon or Vercel Postgres). Use the pooled connection string.
DATABASE_URL=

# 32+ random characters. Signs the session cookie and the client preview links.
APP_SECRET=

# Public base URL of the deployment, no trailing slash (used for redirects and links).
APP_BASE_URL=https://payroll-audit.novumsp.live

# Microsoft Entra ID (single-tenant app registration in Novum's tenant; redirect URI = APP_BASE_URL/auth/microsoft/callback)
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_CLIENT_SECRET=

# Vercel Cron bearer secret; /api/cron/* refuses when unset.
CRON_SECRET=

# Gusto accountant partner app (OAuth). The payroll lead authorizes it once under Admin; tokens are stored encrypted and refreshed automatically.
# Redirect URI to register on the app: APP_BASE_URL/auth/gusto/callback
GUSTO_CLIENT_ID=
GUSTO_CLIENT_SECRET=
GUSTO_API_BASE=https://api.gusto.com
GUSTO_API_VERSION=2024-04-01
# Development only: a static access token for a demo company (expires in two hours). Ignored once the OAuth connection exists.
GUSTO_ACCESS_TOKEN=

# Box Client Credentials Grant for the service account (Viewer on client folders, upload to them).
BOX_CLIENT_ID=
BOX_CLIENT_SECRET=
BOX_SUBJECT_ID=
BOX_SUBJECT_TYPE=enterprise

# JotForm: the URL segment in each form's webhook (APP_BASE_URL/api/webhooks/jotform/<secret>) and the form registry (see config/jotform-forms.example.json).
JOTFORM_WEBHOOK_SECRET=
JOTFORM_FORMS=

# Slack bot token for messages to Novum people; unset, every message is recorded in the inbox only.
SLACK_BOT_TOKEN=
SLACK_POD_CHANNEL=

# Anthropic API key for profile-builder document extraction; unset, documents are listed but not read.
ANTHROPIC_API_KEY=
